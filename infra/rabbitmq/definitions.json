# RabbitMQ — MVP 2
# Este arquivo define as exchanges, queues e bindings iniciais.
# Será importado via: Management Plugin → Import definitions

{
  "vhosts": [{ "name": "/" }],
  "exchanges": [
    {
      "name": "decision.events",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false
    }
  ],
  "queues": [
    {
      "name": "decision.requested",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "decision.dlx",
        "x-message-ttl": 300000
      }
    },
    {
      "name": "decision.completed",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "decision.audit",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "decision.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false
    }
  ],
  "bindings": [
    {
      "source": "decision.events",
      "vhost": "/",
      "destination": "decision.requested",
      "destination_type": "queue",
      "routing_key": "decision.requested"
    },
    {
      "source": "decision.events",
      "vhost": "/",
      "destination": "decision.completed",
      "destination_type": "queue",
      "routing_key": "decision.completed"
    },
    {
      "source": "decision.events",
      "vhost": "/",
      "destination": "decision.audit",
      "destination_type": "queue",
      "routing_key": "decision.*"
    }
  ]
}
