# Copy this file to .env and fill in the values before running the app.
# NEVER commit .env to version control.

# --- Database ---
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://decision_user:CHANGE_ME@localhost:5432/decision_engine

# --- App ---
APP_ENV=production
DEBUG=false

# --- CORS ---
# JSON array of allowed origins. Adjust for your frontend URL(s).
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- Risk Scoring Thresholds ---
APPROVE_THRESHOLD=70.0
MANUAL_REVIEW_THRESHOLD=50.0

# --- Rules Cache ---
# Time-to-live for the in-memory active-rules cache (seconds)
RULES_CACHE_TTL_SECONDS=300
